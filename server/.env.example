NODE_ENV=development
PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://medtrain:medtrain_dev_pw@localhost:5432/medtrain

# Session
SESSION_SECRET=change-this-to-a-long-random-string
# Set to "true" behind HTTPS in production so cookies are marked Secure
COOKIE_SECURE=false

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173

# Initial administrator account, created by the seed script if no users exist
SEED_ADMIN_EMAIL=admin@medtrain.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator

# Optional: path to a Chromium executable for PDF generation.
# Leave unset in normal deployments after running `npx playwright install chromium`.
# PLAYWRIGHT_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# Directory for uploaded training videos (served at /uploads)
UPLOAD_DIR=./uploads
